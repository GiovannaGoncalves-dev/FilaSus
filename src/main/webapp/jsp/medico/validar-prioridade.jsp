<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,br.com.filasus.model.*,br.com.filasus.controller.ValidarPrioridadeController.PrioridadeView" %>
<%!private String h(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");}%>
<%Usuario medico=(Usuario)session.getAttribute("usuarioLogado");List<PrioridadeView> pendentes=(List<PrioridadeView>)request.getAttribute("pendentes");if(pendentes==null)pendentes=Collections.emptyList();int prioridadesPendentes=pendentes.size();String ctx=request.getContextPath(),pageTitle="Validar Prioridade",activeNav="prioridades";%>
<%@ include file="/WEB-INF/jspf/medico-shell-start.jspf" %>
<style>
.pri-grid{display:flex;gap:16px;align-items:stretch;padding-bottom:4px;scroll-snap-type:x proximity}.pri-card{background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--amber-400);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;display:flex;flex-direction:column;flex:0 0 400px;width:400px;scroll-snap-align:start}.pri-card__header{padding:14px 16px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,var(--amber-50),#fff);display:flex;align-items:center;justify-content:space-between;gap:8px}.pri-card__password{font-family:var(--font-mono);font-weight:800;font-size:22px;color:var(--amber-700);line-height:1}.pri-card__body{padding:14px 16px;flex:1;display:flex;flex-direction:column}.pri-card__docs{flex:1}.pri-card__footer{padding:12px 16px;border-top:1px solid var(--border);background:var(--surface-2);display:flex;gap:8px}.pri-card__footer .btn{flex:1}.info-row{display:flex;gap:8px;align-items:center;padding:3px 0;font-size:13px}.info-row__icon{color:var(--text-muted);flex-shrink:0;display:flex}.info-row__label{color:var(--text-muted)}.doc-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);margin-bottom:6px}.doc-item__icon{width:32px;height:32px;border-radius:8px;background:var(--teal-50);color:var(--teal-700);display:flex;align-items:center;justify-content:center;flex-shrink:0}.doc-item__info{flex:1;min-width:0}.doc-item__name{font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.doc-item__desc{font-size:11px;color:var(--text-muted);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.reason-box{background:var(--amber-50);border:1px solid var(--amber-200);border-radius:var(--radius);padding:10px 12px;margin-top:8px;display:flex;gap:8px;align-items:flex-start}.reason-box__icon{color:var(--amber-600);flex-shrink:0;margin-top:1px}.reason-box__label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--amber-700)}.reason-box__value{font-size:14px;font-weight:600;color:var(--amber-800)}.pri-scroller{overflow-x:auto;padding:2px 2px 12px}.pri-scroller::-webkit-scrollbar{height:7px}.pri-scroller::-webkit-scrollbar-thumb{background:var(--slate-300);border-radius:20px}@media(max-width:480px){.pri-card{flex-basis:88vw;width:88vw}.pri-card__footer{flex-direction:column}}
</style>
<%if(request.getAttribute("flashSucesso")!=null){%><div class="alert alert--success mb-4"><%=h(request.getAttribute("flashSucesso"))%></div><%}if(request.getAttribute("flashErro")!=null||request.getAttribute("erro")!=null){%><div class="alert alert--danger mb-4"><%=h(request.getAttribute("flashErro")!=null?request.getAttribute("flashErro"):request.getAttribute("erro"))%></div><%}%>
<div class="page-header"><div><h1 class="page-header__title">Validar Prioridade</h1><p class="page-header__subtitle">Solicitações de prioridade enviadas pelos pacientes, aguardando análise do médico</p></div><div class="page-header__actions"><a href="<%=ctx%>/medico/dashboard" class="btn btn--outline btn--sm"><%=ico("arrowLeft")%> Voltar ao painel</a></div></div>
<div class="card mb-6" style="background:linear-gradient(135deg,var(--amber-50),#fff);border-color:var(--amber-200)"><div class="card__body flex items-center gap-3" style="flex-wrap:wrap"><div style="width:44px;height:44px;border-radius:50%;background:var(--amber-100);color:var(--amber-700);display:flex;align-items:center;justify-content:center;flex-shrink:0"><%=ico("shield")%></div><div style="flex:1;min-width:160px"><div style="font-weight:600;color:var(--amber-800)"><%=prioridadesPendentes==0?"Nenhuma solicitação pendente":prioridadesPendentes==1?"1 solicitação aguardando análise":prioridadesPendentes+" solicitações aguardando análise"%></div><div class="text-sm text-muted mt-2">Analise os documentos e o motivo alegado. Ao aprovar, o paciente passa a ter prioridade no atendimento. Ao rejeitar, permanece na fila como prioridade comum.</div></div><span class="badge badge--amber" style="font-size:14px;padding:6px 14px"><%=prioridadesPendentes%> pendente(s)</span></div></div>
<%if(pendentes.isEmpty()){%><div class="card"><div class="empty-state"><div class="empty-state__icon" style="background:var(--emerald-50);color:var(--emerald-600)"><%=ico("check")%></div><div class="empty-state__title">Tudo em dia!</div><div class="empty-state__message">Não há solicitações de prioridade pendentes no momento. Quando um paciente solicitar prioridade, ela aparecerá aqui.</div><a href="<%=ctx%>/medico/dashboard" class="btn btn--outline mt-4"><%=ico("dashboard")%> Voltar ao painel</a></div></div><%}else{%><div class="pri-scroller"><div class="pri-grid"><%for(PrioridadeView v:pendentes){Documento d=v.documento;%><article class="pri-card"><div class="pri-card__header"><div><div class="text-xs text-muted" style="font-weight:600;text-transform:uppercase;letter-spacing:.05em">Senha</div><div class="pri-card__password">F<%=d.getIdFila()%>-<%=String.format("%03d",d.getSequenciaItemFila())%></div></div><div style="text-align:right"><span class="badge badge--amber"><%=h(d.getMotivoPrioridade()==null?"Prioridade":d.getMotivoPrioridade())%></span><div class="text-xs text-muted mt-2"><%=h(v.fila==null?"Fila":v.fila.getNome())%></div></div></div><div class="pri-card__body"><h3 style="font-size:16px;font-weight:700;margin-bottom:8px"><%=h(v.paciente==null?"Paciente":v.paciente.getNome())%></h3><div class="info-row"><span class="info-row__icon"><%=ico("idCard")%></span><span class="info-row__label">CPF:</span><strong class="font-mono"><%=h(v.paciente==null?d.getCpfUsuario():v.paciente.getCpfFormatado())%></strong></div><div class="info-row"><span class="info-row__icon"><%=ico("list")%></span><span class="info-row__label">Fila:</span><span><%=h(v.fila==null?"—":v.fila.getNome())%></span></div><div class="info-row"><span class="info-row__icon"><%=ico("clock")%></span><span class="info-row__label">Solicitado:</span><span><%=h(d.getEnviadoEm())%></span></div><div class="reason-box"><span class="reason-box__icon"><%=ico("shield")%></span><div><div class="reason-box__label">Motivo alegado</div><div class="reason-box__value"><%=h(d.getMotivoPrioridade()==null?"Não informado":d.getMotivoPrioridade())%></div><%if(d.getDescricao()!=null&&!d.getDescricao().isBlank()){%><div class="text-xs text-muted mt-2"><%=h(d.getDescricao())%></div><%}%></div></div><div class="mt-4 pri-card__docs"><div class="flex items-center justify-between mb-2" style="gap:8px"><div class="text-xs text-muted" style="font-weight:600;text-transform:uppercase;letter-spacing:.05em;display:flex;align-items:center;gap:6px"><%=ico("fileText")%> Documentos comprobatórios</div><span class="badge badge--slate"><%=d.getArquivoUrl()==null?0:1%></span></div><%if(d.getArquivoUrl()==null){%><div style="min-height:48px;display:flex;align-items:center;justify-content:center;text-align:center;border:1px dashed var(--border);border-radius:var(--radius);color:var(--text-muted);font-size:12px">Nenhum documento anexado pelo paciente.</div><%}else{%><div class="doc-item"><div class="doc-item__icon"><%=ico("fileText")%></div><div class="doc-item__info"><div class="doc-item__name"><%=h(d.getNomeOriginal())%></div><div class="doc-item__desc"><%=h(d.getDescricao())%></div></div></div><%}%></div></div><div class="pri-card__footer"><form method="post" action="<%=ctx%>/medico/prioridades" style="display:contents"><input type="hidden" name="idDocumento" value="<%=d.getId()%>"><button class="btn btn--success" name="decisao" value="aprovar" onclick="return confirm('Aprovar esta prioridade?')"><%=ico("check")%> Aprovar</button><button class="btn btn--danger" name="decisao" value="rejeitar" onclick="return confirm('Rejeitar esta prioridade?')"><%=ico("x")%> Rejeitar</button></form></div></article><%}%></div></div><%}%>
<%@ include file="/WEB-INF/jspf/medico-shell-end.jspf" %>
