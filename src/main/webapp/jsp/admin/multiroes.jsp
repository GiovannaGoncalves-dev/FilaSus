<%@ page import="java.util.*,br.com.filasus.model.*,br.com.filasus.model.enums.StatusMutirao" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!private String h(Object v){return v==null?"":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");}private String badge(StatusMutirao s){return s==StatusMutirao.ABERTO?"badge--emerald":s==StatusMutirao.ENCERRADO?"badge--slate":"badge--amber";}%>
<%Usuario admin=(Usuario)session.getAttribute("usuarioLogado");List<Mutirao> ms=(List<Mutirao>)request.getAttribute("mutiroes");List<Unidade> us=(List<Unidade>)request.getAttribute("unidades");if(ms==null)ms=Collections.emptyList();if(us==null)us=Collections.emptyList();boolean geral=br.com.filasus.util.AuthUtil.checarPerfil(request,br.com.filasus.model.enums.PerfilUsuario.ADM_GERAL);String ctx=request.getContextPath(),pageTitle="Mutirões",activeNav="mutiroes";%>
<%@ include file="/WEB-INF/jspf/admin-shell-start.jspf" %>
<div class="admin-heading"><div><h1>Mutirões</h1><p>Planeje e acompanhe as operações de atendimento.</p></div></div>
<section class="card mb-4"><div class="card__header"><div><div class="card__title"><%=ico("plus")%> Novo mutirão</div><div class="card__description">Informe a unidade, local, data e duração da operação.</div></div></div><form method="post" action="<%=ctx%>/admin/mutiroes"><input type="hidden" name="acao" value="criar"><div class="card__body admin-form"><div class="admin-field"><label>Unidade</label><%if(geral){%><select class="select" name="idUnidade" required><%for(Unidade u:us){%><option value="<%=u.getId()%>"><%=h(u.getNome())%></option><%}%></select><%}else{Unidade unidade=us.isEmpty()?null:us.get(0);%><input type="hidden" name="idUnidade" value="<%=unidade==null?"":unidade.getId()%>"><div class="input" style="background:var(--surface-2);display:flex;align-items:center"><%=h(unidade==null?"Unidade ativa":unidade.getNome())%></div><%}%></div><div class="admin-field"><label>Nome ou tipo</label><input class="input" name="tipo" placeholder="Ex.: Mutirão de Cardiologia" required></div><div class="admin-field"><label>Local</label><input class="input" name="local" placeholder="Endereço ou setor" required></div><div class="admin-field"><label>Data</label><input class="input" type="date" name="data" required></div><div class="admin-field"><label>Duração (minutos)</label><input class="input" type="number" name="duracao" value="480" min="1" required></div><button class="btn btn--primary"><%=ico("plus")%> Criar mutirão</button></div></form></section>
<section class="card"><div class="card__header"><div><div class="card__title">Mutirões cadastrados</div><div class="card__description"><%=ms.size()%> operação(ões) encontrada(s).</div></div></div><%if(ms.isEmpty()){%><div class="empty-state"><div class="empty-state__icon"><%=ico("calendar")%></div><div class="empty-state__title">Nenhum mutirão cadastrado</div><div class="empty-state__message">Crie uma operação usando o formulário acima.</div></div><%}else for(Mutirao m:ms){%><div class="admin-row"><div style="display:flex;align-items:center;gap:12px"><div class="stat-card__icon stat-card__icon--teal"><%=ico("calendar")%></div><div><div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><strong><%=h(m.getTipo())%></strong><span class="badge <%=badge(m.getStatus())%>"><%=h(m.getStatus().getDescricao())%></span></div><div style="font-size:12px;color:var(--text-muted);margin-top:3px"><%=h(m.getData())%> · <%=h(m.getLocal())%> · <%=m.getDuracaoMinutos()%> min</div></div></div><form method="post" action="<%=ctx%>/admin/mutiroes" class="admin-actions"><input type="hidden" name="acao" value="status"><input type="hidden" name="idMutirao" value="<%=m.getId()%>"><select class="select" name="status" aria-label="Novo status"><%for(StatusMutirao st:StatusMutirao.values()){%><option value="<%=st.name()%>" <%=st==m.getStatus()?"selected":""%>><%=h(st.getDescricao())%></option><%}%></select><button class="btn btn--outline"><%=ico("refresh")%> Alterar</button></form></div><%}%></section>
<%@ include file="/WEB-INF/jspf/admin-shell-end.jspf" %>
