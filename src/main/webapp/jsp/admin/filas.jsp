<%@ page import="java.util.*,br.com.filasus.model.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!private String h(Object v){return v==null?"":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");}%>
<%Usuario admin=(Usuario)session.getAttribute("usuarioLogado");List<Fila> fs=(List<Fila>)request.getAttribute("filas");List<Mutirao> ms=(List<Mutirao>)request.getAttribute("mutiroes");if(fs==null)fs=Collections.emptyList();if(ms==null)ms=Collections.emptyList();String ctx=request.getContextPath(),pageTitle="Filas",activeNav="filas";%>
<%@ include file="/WEB-INF/jspf/admin-shell-start.jspf" %>
<div class="admin-heading"><div><h1>Filas</h1><p>Configure as filas de atendimento dos mutirões.</p></div></div>
<section class="card mb-4"><div class="card__header"><div><div class="card__title"><%=ico("plus")%> Nova fila</div><div class="card__description">Crie uma fila comum ou prioritária vinculada a um mutirão.</div></div></div><form method="post" action="<%=ctx%>/admin/filas"><input type="hidden" name="acao" value="criar"><div class="card__body admin-form"><div class="admin-field"><label>Mutirão</label><select class="select" name="idMutirao" required><option value="">Selecione</option><%for(Mutirao m:ms){%><option value="<%=m.getId()%>"><%=h(m.getTipo())%> — <%=h(m.getData())%></option><%}%></select></div><div class="admin-field"><label>Nome da fila</label><input class="input" name="nome" placeholder="Ex.: Clínica Médica" required></div><div class="admin-field"><label>Tipo</label><select class="select" name="tipo"><option value="COMUM">Comum</option><option value="PRIORITARIO">Prioritária</option></select></div><button class="btn btn--primary"><%=ico("plus")%> Criar fila</button></div></form></section>
<section class="card"><div class="card__header"><div><div class="card__title">Filas cadastradas</div><div class="card__description"><%=fs.size()%> fila(s) disponível(is).</div></div></div><%if(fs.isEmpty()){%><div class="empty-state"><div class="empty-state__icon"><%=ico("list")%></div><div class="empty-state__title">Nenhuma fila cadastrada</div><div class="empty-state__message">Use o formulário acima para criar a primeira fila.</div></div><%}else for(Fila f:fs){%><div class="admin-row"><div style="display:flex;align-items:center;gap:12px"><div class="stat-card__icon stat-card__icon--teal"><%=ico("list")%></div><div><strong><%=h(f.getNome())%></strong><div style="font-size:12px;color:var(--text-muted)">Código F<%=f.getId()%> · <%=h(f.getTipo().getDescricao())%></div></div></div><div class="admin-actions"><form method="post" action="<%=ctx%>/admin/filas" class="admin-actions"><input type="hidden" name="acao" value="editar"><input type="hidden" name="idFila" value="<%=f.getId()%>"><input class="input" name="nome" value="<%=h(f.getNome())%>" aria-label="Nome da fila" required><select class="select" name="tipo" aria-label="Tipo da fila"><option value="COMUM" <%=f.getTipo().name().equals("COMUM")?"selected":""%>>Comum</option><option value="PRIORITARIO" <%=f.getTipo().name().equals("PRIORITARIO")?"selected":""%>>Prioritária</option></select><button class="btn btn--outline"><%=ico("edit")%> Salvar</button></form><form method="post" action="<%=ctx%>/admin/filas"><input type="hidden" name="acao" value="excluir"><input type="hidden" name="idFila" value="<%=f.getId()%>"><button class="btn btn--danger" onclick="return confirm('Excluir esta fila?')"><%=ico("trash")%> Excluir</button></form></div></div><%}%></section>
<%@ include file="/WEB-INF/jspf/admin-shell-end.jspf" %>
