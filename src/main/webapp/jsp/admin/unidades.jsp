<%@ page import="java.util.*,br.com.filasus.model.*" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!private String h(Object v){return v==null?"":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");}%>
<%Usuario admin=(Usuario)session.getAttribute("usuarioLogado");List<Unidade> us=(List<Unidade>)request.getAttribute("unidades");if(us==null)us=Collections.emptyList();Unidade edicao=(Unidade)request.getAttribute("edicao");String ctx=request.getContextPath(),pageTitle="Unidades",activeNav="unidades";%>
<%@ include file="/WEB-INF/jspf/admin-shell-start.jspf" %>
<div class="admin-heading"><div><h1>Unidades de Saúde</h1><p>Cadastro exclusivo do Administrador Geral. Mutirões e usuários são vinculados a estas unidades.</p></div></div>
<section class="card mb-4"><div class="card__header"><div><div class="card__title"><%=ico(edicao==null?"plus":"edit")%> <%=edicao==null?"Nova unidade":"Editar unidade"%></div><div class="card__description"><%=edicao==null?"Informe o nome e o endereço da unidade.":"Alterando a unidade #"+edicao.getId()+"."%></div></div></div><form method="post" action="<%=ctx%>/admin/unidades"><input type="hidden" name="acao" value="<%=edicao==null?"criar":"editar"%>"><%if(edicao!=null){%><input type="hidden" name="idUnidade" value="<%=edicao.getId()%>"><%}%><div class="card__body admin-form"><div class="admin-field"><label>Nome da unidade</label><input class="input" name="nome" placeholder="Ex.: UBS Centro" value="<%=edicao==null?"":h(edicao.getNome())%>" required></div><div class="admin-field"><label>Endereço</label><input class="input" name="endereco" placeholder="Ex.: Rua das Flores, 100" value="<%=edicao==null?"":h(edicao.getEndereco())%>"></div><button class="btn btn--primary"><%=ico(edicao==null?"plus":"check")%> <%=edicao==null?"Cadastrar unidade":"Salvar alterações"%></button><%if(edicao!=null){%><a class="btn btn--outline" href="<%=ctx%>/admin/unidades"><%=ico("x")%> Cancelar</a><%}%></div></form></section>
<section class="card"><div class="card__header"><div><div class="card__title">Unidades cadastradas</div><div class="card__description"><%=us.size()%> unidade(s) no sistema.</div></div></div><%if(us.isEmpty()){%><div class="empty-state"><div class="empty-state__icon"><%=ico("mapPin")%></div><div class="empty-state__title">Nenhuma unidade cadastrada</div><div class="empty-state__message">Use o formulário acima para cadastrar a primeira unidade.</div></div><%}else for(Unidade u:us){%><div class="admin-row"><div style="display:flex;align-items:center;gap:12px"><div class="stat-card__icon stat-card__icon--teal"><%=ico("mapPin")%></div><div><strong><%=h(u.getNome())%></strong><div style="font-size:12px;color:var(--text-muted)">Unidade #<%=u.getId()%><%=u.getEndereco()==null||u.getEndereco().isEmpty()?"":" · "+h(u.getEndereco())%></div></div></div><div class="admin-actions"><a class="btn btn--outline" href="<%=ctx%>/admin/unidades?editar=<%=u.getId()%>"><%=ico("edit")%> Editar</a><form method="post" action="<%=ctx%>/admin/unidades"><input type="hidden" name="acao" value="excluir"><input type="hidden" name="idUnidade" value="<%=u.getId()%>"><button class="btn btn--danger" onclick="return confirm('Excluir a unidade <%=h(u.getNome())%>? Só é possível se não houver mutirões ou usuários vinculados.')"><%=ico("trash")%> Excluir</button></form></div></div><%}%></section>
<%@ include file="/WEB-INF/jspf/admin-shell-end.jspf" %>
