<%@ page import="java.util.*,br.com.filasus.model.*,br.com.filasus.model.enums.*,br.com.filasus.util.AuthUtil" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!private String h(Object v){return v==null?"":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");}%>
<%Usuario admin=(Usuario)session.getAttribute("usuarioLogado");List<Usuario> xs=(List<Usuario>)request.getAttribute("usuarios");List<Unidade> us=(List<Unidade>)request.getAttribute("unidades");if(xs==null)xs=Collections.emptyList();if(us==null)us=Collections.emptyList();boolean geral=AuthUtil.checarPerfil(request,PerfilUsuario.ADM_GERAL);String ctx=request.getContextPath(),pageTitle="Usuários",activeNav="usuarios";%>
<%@ include file="/WEB-INF/jspf/admin-shell-start.jspf" %>
<div class="admin-heading"><div><h1>Usuários</h1><p>Cadastre profissionais e gerencie os acessos ao sistema.</p></div></div>
<section class="card mb-4"><div class="card__header"><div><div class="card__title"><%=ico("userPlus")%> Novo usuário</div><div class="card__description">Defina os dados de acesso, perfil e unidade de atuação.</div></div></div><form method="post" action="<%=ctx%>/admin/usuarios"><input type="hidden" name="acao" value="criar"><div class="card__body admin-form"><div class="admin-field"><label>CPF</label><input class="input" name="cpf" inputmode="numeric" placeholder="000.000.000-00" required></div><div class="admin-field"><label>Nome completo</label><input class="input" name="nome" placeholder="Nome do usuário" required></div><div class="admin-field"><label>E-mail</label><input class="input" type="email" name="email" placeholder="usuario@exemplo.com" required></div><div class="admin-field"><label>Senha inicial</label><input class="input" type="password" name="senha" minlength="8" placeholder="Mínimo de 8 caracteres" required></div><div class="admin-field"><label>Perfil</label><select class="select" name="perfil"><%if(geral){%><option value="PACIENTE">Paciente</option><%}%><option value="ATENDENTE">Atendente</option><option value="MEDICO">Médico</option><%if(geral){%><option value="ADM_UNIDADE">Administrador de unidade</option><option value="ADM_GERAL">Administrador geral</option><%}%></select></div><div class="admin-field"><label>Unidade</label><%if(geral){%><select class="select" name="idUnidade"><option value="">Sem vínculo</option><%for(Unidade u:us){%><option value="<%=u.getId()%>"><%=h(u.getNome())%></option><%}%></select><%}else{Unidade unidade=us.isEmpty()?null:us.get(0);%><input type="hidden" name="idUnidade" value="<%=unidade==null?"":unidade.getId()%>"><div class="input" style="background:var(--surface-2);display:flex;align-items:center"><%=h(unidade==null?"Unidade ativa":unidade.getNome())%></div><%}%></div><div class="admin-field"><label>Especialidade</label><input class="input" name="especialidade" placeholder="Somente para médico"></div><button class="btn btn--primary"><%=ico("userPlus")%> Cadastrar</button></div></form></section>
<section class="card"><div class="card__header"><div><div class="card__title">Usuários cadastrados</div><div class="card__description"><%=xs.size()%> usuário(s) visível(is) no seu escopo.</div></div></div><%if(xs.isEmpty()){%><div class="empty-state"><div class="empty-state__icon"><%=ico("users")%></div><div class="empty-state__title">Nenhum usuário encontrado</div><div class="empty-state__message">Cadastre o primeiro usuário usando o formulário acima.</div></div><%}else for(Usuario u:xs){%><div class="admin-row"><div style="display:flex;align-items:center;gap:12px;min-width:0"><div class="avatar avatar--admin"><%=h(u.getNome().substring(0,1).toUpperCase())%></div><div style="min-width:0"><strong><%=h(u.getNome())%></strong><div style="font-size:12px;color:var(--text-muted);overflow-wrap:anywhere"><%=h(u.getCpfFormatado())%> · <%=h(u.getEmail())%><%=u.getEspecialidade()!=null&&!u.getEspecialidade().isBlank()?" · "+h(u.getEspecialidade()):""%></div></div></div><div class="admin-actions"><span class="badge <%=u.isAtivo()?"badge--emerald":"badge--rose"%>"><%=u.isAtivo()?"Ativo":"Inativo"%></span><form method="post" action="<%=ctx%>/admin/usuarios"><input type="hidden" name="acao" value="alternar"><input type="hidden" name="cpf" value="<%=h(u.getCpf())%>"><button class="btn btn--outline btn--sm" onclick="return confirm('Alterar situação deste usuário?')"><%=u.isAtivo()?ico("ban"):ico("check")%> <%=u.isAtivo()?"Desativar":"Ativar"%></button></form></div></div><%}%></section>
<%@ include file="/WEB-INF/jspf/admin-shell-end.jspf" %>
