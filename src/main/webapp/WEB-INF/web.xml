<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>FilaSUS</display-name>
  <description>Sistema de Fila de Atendimento Online para Mutirões do SUS</description>

  <!-- Os .jsp usam JS puro com template literals ${...} — desliga o EL do JSP
       pra não confundir com Expression Language -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <el-ignored>true</el-ignored>
    </jsp-property-group>
  </jsp-config>

  <!-- Página inicial -->
  <welcome-file-list>
    <welcome-file>jsp/index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Erro 404 -->
  <error-page>
    <error-code>404</error-code>
    <location>/jsp/login.jsp</location>
  </error-page>

  <!-- Session config (30 minutos) -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>
</web-app>
