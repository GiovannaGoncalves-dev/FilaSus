<%-- Requer: ctx, pageTitle, activeNav, medico e prioridadesPendentes --%>
<%@ include file="/WEB-INF/jspf/icons.jspf" %>
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FilaSUS — <%=pageTitle%></title><link rel="stylesheet" href="<%=ctx%>/css/styles.css"><style>
.medical-heading{margin-bottom:24px}.medical-heading h1{font-size:24px;font-weight:700}.medical-heading p{font-size:14px;color:var(--text-muted);margin-top:3px}.medical-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px;border-bottom:1px solid var(--border)}.medical-row:last-child{border:0}.medical-actions{display:flex;gap:8px;flex-wrap:wrap}.medical-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:14px 0}.medical-fact{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius);padding:12px}.medical-fact small{display:block;color:var(--text-muted);font-size:10px;text-transform:uppercase;font-weight:600;margin-bottom:4px}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px}.page-header__title{font-size:24px;font-weight:700;line-height:1.2}.page-header__subtitle{font-size:14px;color:var(--text-muted);margin-top:4px}.page-header__actions{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:700px){.medical-row{align-items:flex-start;flex-direction:column}.page-header{flex-direction:column}.page-header__actions{width:100%}}
</style></head><body><div class="app-shell"><header class="header"><div class="header__title"><button type="button" class="header__mobile-toggle" onclick="toggleMedicalMenu()" aria-label="Abrir menu"><%=ico("list")%></button><span><%=pageTitle%></span></div><div class="header__actions"><a href="<%=ctx%>/painel" class="btn btn--outline btn--sm"><%=ico("tv")%><span class="hidden-mobile">Painel</span></a></div></header><div class="app-shell__body"><aside class="sidebar" id="sidebar"><div class="sidebar__brand"><div class="sidebar__brand-icon"><%=ico("heart")%></div><div><div style="font-weight:700;line-height:1.1">FilaSUS</div><div style="font-size:10px;color:var(--text-muted);line-height:1.1">Fila de Atendimento</div></div></div><nav class="sidebar__nav"><div><div class="sidebar__group-label">ATENDIMENTO</div>
<a class="sidebar__item <%="dashboard".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/medico/dashboard"><span class="sidebar__item-icon"><%=ico("dashboard")%></span><span class="sidebar__item-label">Painel</span></a>
<a class="sidebar__item <%="atendimento".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/medico/atendimento"><span class="sidebar__item-icon"><%=ico("stethoscope")%></span><span class="sidebar__item-label">Atendimento</span></a>
<a class="sidebar__item <%="prioridades".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/medico/prioridades"><span class="sidebar__item-icon"><%=ico("shield")%></span><span class="sidebar__item-label">Validar Prioridade</span><%if(prioridadesPendentes>0){%><span class="sidebar__item-badge"><%=prioridadesPendentes%></span><%}%></a>
</div></nav><div class="sidebar__user"><div class="sidebar__user-card"><div class="avatar avatar--medico"><%=medico==null?"M":h(medico.getNome().substring(0,1).toUpperCase())%></div><div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%=medico==null?"Médico":h(medico.getNome())%></div><div style="font-size:10px;color:var(--text-muted)">Médico<%=medico!=null&&medico.getEspecialidade()!=null?" · "+h(medico.getEspecialidade()):""%></div></div><form method="post" action="<%=ctx%>/logout"><button class="btn btn--ghost btn--icon" title="Sair" aria-label="Sair"><%=ico("logout")%></button></form></div></div></aside><main class="main"><div class="main__inner">
