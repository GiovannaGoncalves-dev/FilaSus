<%@ include file="/WEB-INF/jspf/icons.jspf" %>
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FilaSUS — <%=pageTitle%></title><link rel="stylesheet" href="<%=ctx%>/css/styles.css"><style>
.admin-heading{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:24px}.admin-heading h1{font-size:24px;font-weight:700}.admin-heading p{font-size:14px;color:var(--text-muted);margin-top:3px}.admin-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px;border-bottom:1px solid var(--border)}.admin-row:last-child{border:0}.admin-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.admin-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;align-items:end}.admin-field{display:flex;flex-direction:column;gap:5px}.admin-field label{font-size:11px;font-weight:600}@media(max-width:700px){.admin-row{align-items:flex-start;flex-direction:column}}
</style></head><body><div class="app-shell"><header class="header"><div class="header__title"><button type="button" class="header__mobile-toggle" onclick="toggleAdminMenu()" aria-label="Abrir menu"><%=ico("list")%></button><span><%=pageTitle%></span></div><div class="header__actions"><a href="<%=ctx%>/painel" class="btn btn--outline btn--sm"><%=ico("tv")%><span class="hidden-mobile">Painel</span></a></div></header><div class="app-shell__body"><aside class="sidebar" id="sidebar"><div class="sidebar__brand"><div class="sidebar__brand-icon"><%=ico("heart")%></div><div><div style="font-weight:700;line-height:1.1">FilaSUS</div><div style="font-size:10px;color:var(--text-muted);line-height:1.1">Fila de Atendimento</div></div></div><nav class="sidebar__nav"><div><div class="sidebar__group-label">ADMINISTRAÇÃO</div>
<a class="sidebar__item <%="dashboard".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/admin/dashboard"><span class="sidebar__item-icon"><%=ico("dashboard")%></span><span class="sidebar__item-label">Painel Geral</span></a>
<a class="sidebar__item <%="mutiroes".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/admin/mutiroes"><span class="sidebar__item-icon"><%=ico("calendar")%></span><span class="sidebar__item-label">Mutirões</span></a>
<a class="sidebar__item <%="filas".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/admin/filas"><span class="sidebar__item-icon"><%=ico("list")%></span><span class="sidebar__item-label">Filas</span></a>
<a class="sidebar__item <%="usuarios".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/admin/usuarios"><span class="sidebar__item-icon"><%=ico("users")%></span><span class="sidebar__item-label">Usuários</span></a>
<a class="sidebar__item <%="relatorios".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/admin/relatorios"><span class="sidebar__item-icon"><%=ico("chart")%></span><span class="sidebar__item-label">Relatórios</span></a>
<%if(br.com.filasus.util.AuthUtil.checarPerfil(request,br.com.filasus.model.enums.PerfilUsuario.ADM_GERAL)){%><a class="sidebar__item <%="unidades".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/admin/unidades"><span class="sidebar__item-icon"><%=ico("mapPin")%></span><span class="sidebar__item-label">Unidades</span></a><%}%>
</div></nav><div class="sidebar__user"><div class="sidebar__user-card"><div class="avatar avatar--admin"><%=admin==null?"A":h(admin.getNome().substring(0,1).toUpperCase())%></div><div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%=admin==null?"Administrador":h(admin.getNome())%></div><div style="font-size:10px;color:var(--text-muted)">Administrador</div></div><form method="post" action="<%=ctx%>/logout"><button class="btn btn--ghost btn--icon" title="Sair" aria-label="Sair"><%=ico("logout")%></button></form></div></div></aside><main class="main"><div class="main__inner"><%if(request.getAttribute("flashSucesso")!=null){%><div class="alert alert--success mb-4"><%=ico("check")%><div><%=h(request.getAttribute("flashSucesso"))%></div></div><%}if(request.getAttribute("flashErro")!=null||request.getAttribute("erro")!=null){%><div class="alert alert--danger mb-4"><%=ico("alert")%><div><%=h(request.getAttribute("flashErro")!=null?request.getAttribute("flashErro"):request.getAttribute("erro"))%></div></div><%}%>
