</div></main></div><footer class="footer">FilaSUS © 2026 — Giovanna Gonçalves & Matheus Souza Rosa</footer></div><script>function toggleMedicalMenu(){var s=document.getElementById('sidebar'),b=document.querySelector('.sidebar-backdrop'),o=!s.classList.contains('open');s.classList.toggle('open',o);s.classList.toggle('sidebar--mobile',o);document.body.classList.toggle('mobile-nav-open',o);if(o&&!b){b=document.createElement('div');b.className='sidebar-backdrop';b.onclick=toggleMedicalMenu;document.body.appendChild(b)}else if(!o&&b)b.remove()}</script></body></html>
