</div></main></div><footer class="footer">FilaSUS © 2026 — Giovanna Gonçalves & Matheus Souza Rosa</footer></div><script>function toggleAttendantMenu(){var s=document.getElementById('sidebar'),b=document.querySelector('.sidebar-backdrop'),opening=!s.classList.contains('open');s.classList.toggle('open',opening);s.classList.toggle('sidebar--mobile',opening);document.body.classList.toggle('mobile-nav-open',opening);if(opening&&!b){b=document.createElement('div');b.className='sidebar-backdrop';b.onclick=toggleAttendantMenu;document.body.appendChild(b)}else if(!opening&&b){b.remove()}}</script></body></html>
