<%-- Requer no escopo: String ctx, pageTitle, activeNav; Usuario usuario --%>
<%@ include file="/WEB-INF/jspf/icons.jspf" %>
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FilaSUS — <%=pageTitle%></title><link rel="stylesheet" href="<%=ctx%>/css/styles.css"><style>
.server-page-heading{margin-bottom:24px}.server-page-heading h1{font-size:24px;font-weight:700;letter-spacing:-.025em}.server-page-heading p{font-size:14px;color:var(--text-muted);margin-top:3px}.server-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.server-metric{font-size:28px;font-weight:700;margin-top:8px}.server-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px;border-bottom:1px solid var(--border)}.server-row:last-child{border:0}.server-table-wrap{overflow:auto}.server-message{margin-bottom:16px}.server-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.server-field{display:flex;flex-direction:column;gap:5px}.server-field label{font-size:12px;font-weight:600}.server-session{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.server-session__icon{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,var(--teal-500),var(--emerald-600));color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px}@media(max-width:700px){.server-form-grid{grid-template-columns:1fr}.server-row{align-items:flex-start;flex-direction:column}}
</style></head><body><div class="app-shell"><header class="header"><div class="header__title"><button type="button" class="header__mobile-toggle" onclick="toggleAttendantMenu()"><%=ico("list")%></button><span><%=pageTitle%></span></div><div class="header__actions"><a href="<%=ctx%>/painel" class="btn btn--outline btn--sm"><%=ico("tv")%><span class="hidden-mobile">Painel</span></a></div></header><div class="app-shell__body"><aside class="sidebar" id="sidebar"><div class="sidebar__brand"><div class="sidebar__brand-icon"><%=ico("heart")%></div><div><div style="font-weight:700">FilaSUS</div><div style="font-size:10px;color:var(--text-muted)">Fila de Atendimento</div></div></div><nav class="sidebar__nav"><div><div class="sidebar__group-label">OPERAÇÃO</div><a class="sidebar__item <%="dashboard".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/atendente/dashboard"><span class="sidebar__item-icon"><%=ico("dashboard")%></span><span>Painel</span></a><a class="sidebar__item <%="cadastro".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/atendente/cadastrar-paciente"><span class="sidebar__item-icon"><%=ico("userPlus")%></span><span>Cadastrar Paciente</span></a><a class="sidebar__item <%="fila".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/atendente/fila"><span class="sidebar__item-icon"><%=ico("list")%></span><span>Gerenciar Fila</span></a><a class="sidebar__item <%="historico".equals(activeNav)?"sidebar__item--active":""%>" href="<%=ctx%>/atendente/historico"><span class="sidebar__item-icon"><%=ico("history")%></span><span>Histórico</span></a></div></nav><div class="sidebar__user"><div class="sidebar__user-card"><div class="avatar avatar--atendente"><%=usuario==null?"A":h(usuario.getNome().substring(0,1).toUpperCase())%></div><div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:500"><%=usuario==null?"Atendente":h(usuario.getNome())%></div><div style="font-size:10px;color:var(--text-muted)">Atendente</div></div><form method="post" action="<%=ctx%>/logout"><button class="btn btn--ghost btn--icon" title="Sair"><%=ico("logout")%></button></form></div></div></aside><main class="main"><div class="main__inner">
